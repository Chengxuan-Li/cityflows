{
  "name": "cityflows",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based city traffic sandbox: individual vehicles on lane-level road networks imported from OpenStreetMap or drawn by hand.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:city": "vitest run --project city",
    "test:traffic": "vitest run --project traffic",
    "test:traffic:light": "vitest run --project traffic tests/traffic/munich-morning.test.ts tests/traffic/T53-munich-pedestrians.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:light": "playwright test",
    "bench": "node --experimental-strip-types --expose-gc --import ./bench/register.ts ./bench/sim.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "import-probe": "node --experimental-strip-types --import ./bench/register.ts ./bench/import-probe.ts",
    "route-audit": "node --experimental-strip-types --import ./bench/register.ts ./bench/route-audit.ts",
    "geometry-audit": "node --experimental-strip-types --import ./bench/register.ts ./bench/geometry-audit.ts",
    "geometry-shots": "node --experimental-strip-types --import ./bench/register.ts ./bench/geometry-shots.ts",
    "traffic:quick": "node --experimental-strip-types --import ./bench/register.ts ./bench/traffic-quick.ts"
  },
  "dependencies": {
    "@types/three": "0.187.0",
    "clipper2-ts": "2.0.1-18",
    "fast-png": "8.0.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "^0.8.3",
    "flatbush": "4.7.0",
    "maplibre-gl": "6.16.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
